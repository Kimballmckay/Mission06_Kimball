@{
}

@model Movie

<h1>Add a Movie to the Collection</h1>

<form method="post">

    <label asp-for="Category">Category</label>
    <select asp-for="Category">
        <option value="" disabled selected>-- Select a Category --</option>
        <option value="Action/Adventure">Action/Adventure</option>
        <option value="Comedy">Comedy</option>
        <option value="Drama">Drama</option>
        <option value="Family">Family</option>
        <option value="Horror/Suspense">Horror/Suspense</option>
        <option value="Miscellaneous">Miscellaneous</option>
        <option value="Television">Television</option>
        <option value="VHS">VHS</option>
    </select>
    <span asp-validation-for="Category" class="text-danger"></span>
    <br />

    <label asp-for="Title">Title:</label>
    <input asp-for="Title" />
    <span asp-validation-for="Title" class="text-danger"></span>
    <br />

    <label asp-for="Year">Year:</label>
    <input asp-for="Year" />
    <span asp-validation-for="Year" class="text-danger"></span>
    <br />

    <label asp-for="Director">Director:</label>
    <input asp-for="Director" />
    <span asp-validation-for="Director" class="text-danger"></span>
    <br />

    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating">
        <option value="" disabled selected>-- Select a Rating --</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
        <option value="NR">NR</option>
        <option value="UR">UR</option>
    </select>
    <span asp-validation-for="Rating" class="text-danger"></span>
    <br />

    <label asp-for="Edited">Edited?</label>
    <select asp-for="Edited">
        <option value="False">No</option>
        <option value="True">Yes</option>
    </select>
    <br />

    <label asp-for="Lent">Lent?</label>
    <input asp-for="Lent" />
    <br />

    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes" />
    <br />

    <button type="submit">Add Movie</button>

</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
